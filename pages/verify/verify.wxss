.page { min-height: 100vh; background: #f5f7fa; padding: 30rpx; box-sizing: border-box; }

.header { text-align: center; margin-bottom: 40rpx; padding-top: 20rpx; }
.title { font-size: 40rpx; font-weight: 800; color: #1a1a2e; }
.subtitle { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.input-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  margin-bottom: 30rpx;
  position: relative;
}
.input {
  width: 100%;
  height: 180rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
  background: #fafafa;
}
.input-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}
.input-count.valid { color: #07c160; font-weight: 700; }

.solve-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
  margin: 0 0 24rpx 0;
}
.solve-btn.btn-busy { background: #ccc; }

.init-progress {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.init-msg {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.error-box {
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.error-text { font-size: 28rpx; color: #cf1322; }

.result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  margin-bottom: 24rpx;
}
.result-card.solved { text-align: center; padding: 48rpx; }
.result-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.result-title { font-size: 32rpx; font-weight: 700; color: #1a1a2e; }
.result-count { font-size: 26rpx; color: #888; }
.result-icon { font-size: 56rpx; margin-bottom: 12rpx; }
.steps {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  word-break: break-all;
  line-height: 1.6;
}