.page { min-height: 100vh; background: #f5f7fa; padding: 30rpx; box-sizing: border-box; }

/* Capture */
.phase-capture { display: flex; flex-direction: column; align-items: center; padding-top: 60rpx; }
.capture-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  margin-bottom: 40rpx;
}
.capture-label { font-size: 26rpx; color: #999; text-transform: uppercase; letter-spacing: 2rpx; }
.capture-face { font-size: 48rpx; font-weight: 800; color: #1a1a2e; margin: 16rpx 0; }
.capture-hint { font-size: 26rpx; color: #888; margin-bottom: 32rpx; }
.capture-btn {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border: none;
  color: #fff;
}
.progress-row { width: 100%; display: flex; flex-direction: column; align-items: center; }
.thumbs { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 20rpx; }
.thumb { width: 80rpx; height: 80rpx; border-radius: 16rpx; background: #e8e8e8; display: flex; justify-content: center; align-items: center; font-size: 28rpx; color: #bbb; font-weight: 600; }
.thumb.done { background: linear-gradient(135deg, #07c160, #10b981); color: #fff; box-shadow: 0 4rpx 12rpx rgba(7,193,96,0.3); }
.progress-text { font-size: 28rpx; color: #666; font-weight: 600; }

/* Review */
.phase-review { padding-bottom: 40rpx; }
.review-header { text-align: center; margin-bottom: 30rpx; }
.review-title { font-size: 40rpx; font-weight: 800; color: #1a1a2e; }
.review-hint { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.faces-wrap { display: flex; flex-wrap: wrap; justify-content: space-between; }
.face-block { width: 48%; margin-bottom: 24rpx; background: #fff; border-radius: 16rpx; padding: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); box-sizing: border-box; }
.face-title-wrap { text-align: center; margin-bottom: 12rpx; }
.face-title { font-size: 28rpx; font-weight: 700; color: #333; }
.face-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: 6rpx; }
.cell {
  display: flex; justify-content: center; align-items: center;
  font-size: 28rpx; font-weight: 700; height: 80rpx; border-radius: 8rpx;
  border: 3rpx solid transparent; color: #fff;
  text-shadow: 0 0 4rpx #000, 0 0 8rpx #000;
  transition: border 0.1s;
}
.cell.selected { border: 5rpx solid #1a1a2e; }

.picker-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.picker-label { text-align: center; font-size: 26rpx; color: #999; margin-bottom: 16rpx; font-weight: 600; }
.color-picker-bar { display: flex; justify-content: space-around; }
.picker-cell { width: 84rpx; height: 84rpx; display: flex; justify-content: center; align-items: center; border-radius: 16rpx; font-size: 30rpx; font-weight: 700; color: #333; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1); }
.picker-cell:active { transform: scale(0.92); }

.review-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 20rpx; }
.action-btn { width: 100%; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; font-size: 30rpx; font-weight: 700; border: none; margin: 0; }
.action-btn.primary { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
.action-btn.secondary { background: #e8e8e8; color: #666; }

/* Result */
.phase-result { padding-bottom: 40rpx; }
.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  margin-bottom: 30rpx;
}
.result-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.result-title { font-size: 40rpx; font-weight: 800; color: #1a1a2e; }
.result-count { font-size: 28rpx; color: #888; margin-top: 8rpx; }
.steps-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.steps-label { font-size: 26rpx; color: #999; font-weight: 600; margin-bottom: 12rpx; }
.steps { font-size: 32rpx; font-weight: 700; color: #333; word-break: break-all; line-height: 1.6; }